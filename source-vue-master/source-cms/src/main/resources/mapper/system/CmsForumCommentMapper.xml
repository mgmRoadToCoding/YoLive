<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.source.system.mapper.CmsForumCommentMapper">

    <resultMap id="CmsForumCommentResult" type="cn.source.system.domain.CmsForumComment">
        <id property="id" column="id" />
        <result property="postId" column="post_id" />
        <result property="userId" column="user_id" />
        <result property="content" column="content" />
        <result property="isDeleted" column="is_deleted" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id, post_id, user_id, content, is_deleted, create_time, update_time
    </sql>

    <insert id="insertCmsForumComment" parameterType="cn.source.system.domain.CmsForumComment" useGeneratedKeys="true" keyProperty="id">
        insert into cms_forum_comment (post_id, user_id, content, is_deleted, create_time, update_time)
        values (#{postId}, #{userId}, #{content}, 0, #{createTime}, #{updateTime})
    </insert>

    <update id="softDeleteCmsForumCommentById" parameterType="long">
        update cms_forum_comment set is_deleted = 1, update_time = now() where id = #{id}
    </update>

    <select id="selectCmsForumCommentListByPostId" resultMap="CmsForumCommentResult" parameterType="long">
        select <include refid="Base_Column_List"/> from cms_forum_comment
        where is_deleted = 0 and post_id = #{postId}
        order by create_time asc
    </select>

</mapper>